# start.ps1 automatically creates random local passwords and a JWT secret.
MYSQL_PASSWORD=replace-with-random-password
PG_PASSWORD=replace-with-random-password
MINIO_USER=hrmadmin
MINIO_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-base64-encoded-32-random-bytes
# Leave these defaults for offline demo. See 使用说明.md for real DashScope setup.
LLM_API_KEY=local-demo
LLM_BASE_URL=http://demo-model:8090/compatible-mode
LLM_CHAT_MODEL=hrm-demo-extractive
LLM_EMBEDDING_MODEL=hrm-demo-hash-1024
